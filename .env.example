# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของตัวเอง (ไฟล์ .env ห้าม commit — อยู่ใน .gitignore แล้ว)

# --- ถ้ารันด้วย docker compose: ตั้งแค่ POSTGRES_PASSWORD, JWT_SECRET, ALLOWED_ORIGINS (DATABASE_URL compose สร้างให้เอง) ---
# รหัสผ่านของ Postgres ใน container (ใช้เฉพาะ docker compose) ใช้ตัวอักษรกับตัวเลขล้วน (อักขระอย่าง @ / : # จะทำให้ DATABASE_URL เพี้ยน)
POSTGRES_PASSWORD=non1234

# --- ถ้ารัน `go run .` เอง: ต้องมี DATABASE_URL ---
# สตริงเชื่อมต่อ PostgreSQL (เช่น Supabase / Neon / ในเครื่อง)
DATABASE_URL=postgresql://user:password@localhost:5432/techreview?sslmode=disable

# กุญแจเซ็นตั๋ว JWT ต้องยาวอย่างน้อย 32 ตัวอักษร และสุ่มให้ไม่ซ้ำกับที่ไหน
# สร้างได้ด้วย:  openssl rand -base64 48
JWT_SECRET= 6fcfb5ff5b07016e8e72b7379adb6f8f7a31abd70b7aad7fecedd4203d5940d4

# เว็บที่ได้รับอนุญาตให้เรียก API (CORS) คั่นด้วยจุลภาค ใส่ URL ของหน้าเว็บบน Vercel ด้วย
ALLOWED_ORIGINS=http://localhost:3000

# พอร์ต (Render ตั้งให้เอง ในเครื่องไม่ใส่ก็ใช้ 8080)
# PORT=8080
